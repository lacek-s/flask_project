{% extends "_main.jinja" %}

{% block title %} Welcome to Markdown blog {% endblock %}

{%  block main %}
    {% if articles %}
        <ul>
        {% for id, article in articles %}
            <li>
                <h2><a href="{{ url_for("view_article", art_id=article.id) }}" >{{ article.title }}</a></h2>
                <p> {{ article.content | truncate(100) }}</p>
        </li>
        {% endfor %}
        </ul>
    {% else %}
        <p> No Articles :( </p>
    {% endif %}
{% endblock %}